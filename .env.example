# Direct n8n webhook URL (used for initial prototype; can later be replaced by a server-side /api/chat route)
VITE_N8N_WEBHOOK_URL=

# Optional: Supabase public client configuration (safe for browser when RLS is enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DO NOT put server secrets here!
# Configure these inside Supabase Dashboard -> Edge Functions -> Secrets (or supabase secrets set):
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
